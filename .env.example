# RelayPulse Configuration
# RelayPulse is 100% self-contained using an embedded SQLite WAL database by default.

# Host and Port for REST control plane
RELAYPULSE_HOST=127.0.0.1
RELAYPULSE_PORT=8443

# Database path for durable queue and DLQ ledger
RELAYPULSE_DB_PATH=relaypulse.db

# Maximum delivery retry attempts before routing to Dead-Letter Queue (default: 5)
RELAYPULSE_MAX_RETRIES=5

# Base backoff in seconds for exponential backoff calculation (default: 1.0)
RELAYPULSE_BASE_BACKOFF_SECONDS=1.0

# Circuit breaker consecutive failure threshold per destination (default: 5)
RELAYPULSE_CIRCUIT_FAILURE_THRESHOLD=5

# Circuit breaker cooldown reset period in seconds (default: 30)
RELAYPULSE_CIRCUIT_COOLDOWN_SECONDS=30
